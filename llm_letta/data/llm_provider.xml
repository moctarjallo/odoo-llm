<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Local server option (for self-hosted Letta) -->
    <record id="llm_provider_letta_local" model="llm.provider">
        <field name="name">Letta (Local)</field>
        <field name="service">letta</field>
        <field name="active" eval="True" />
        <field name="api_base">http://localhost:8283</field>
        <!-- No API key needed for local server -->
    </record>

    <!-- Letta Cloud option (API key set by bootstrap) -->
    <record id="llm_provider_letta_cloud" model="llm.provider">
        <field name="name">Letta (Cloud)</field>
        <field name="service">letta</field>
        <field name="active" eval="False" />
        <field name="api_base">https://api.letta.com</field>
    </record>
</odoo>
